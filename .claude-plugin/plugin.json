{
  "name": "trainnr",
  "displayName": "trainnr",
  "version": "0.1.0",
  "description": "The end-to-end robotics platform, run from your coding agent: identify the robot from its telemetry, generate datasets, train policies by reinforcement or imitation learning, evaluate with exact intervals, gate and deploy, watch the telemetry for drift. One MCP server, seven agents and two skills.",
  "author": {
    "name": "Trainnr AI",
    "url": "https://trainnr.ai"
  },
  "homepage": "https://trainnr.ai",
  "repository": "https://github.com/Trainnr-AI/trainnr",
  "license": "FSL-1.1-ALv2",
  "keywords": [
    "robotics",
    "simulation",
    "mujoco",
    "mjlab",
    "reinforcement-learning",
    "sim-to-real",
    "system-identification",
    "mcp"
  ],
  "skills": "./.claude/skills",
  "agents": [
    "./.claude/agents/data-generator.md",
    "./.claude/agents/deploy-engineer.md",
    "./.claude/agents/evaluator.md",
    "./.claude/agents/policy-trainer.md",
    "./.claude/agents/robot-onboarding.md",
    "./.claude/agents/system-identification.md",
    "./.claude/agents/task-designer.md"
  ],
  "mcpServers": {
    "trainnr": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}/trainnr",
        "--extra",
        "sim",
        "--extra",
        "mcp",
        "trainnr",
        "mcp"
      ]
    }
  }
}
