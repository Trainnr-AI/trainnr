{
  "name": "trainnr",
  "displayName": "trainnr",
  "version": "0.1.0",
  "description": "The physical AI platform for robot learning, run from your coding agent: data collection and telemetry, real-to-sim system identification, simulation, synthetic data, reinforcement and imitation learning, evaluation, sim-to-real deployment, and the data flywheel back into training. One MCP server, the Studio (downloaded on first use), seven agents and two skills.",
  "author": {
    "name": "Trainnr AI",
    "url": "https://github.com/Trainnr-AI/trainnr"
  },
  "homepage": "https://github.com/Trainnr-AI/trainnr",
  "repository": "https://github.com/Trainnr-AI/trainnr",
  "license": "FSL-1.1-ALv2",
  "keywords": [
    "physical-ai",
    "robotics",
    "robot-learning",
    "reinforcement-learning",
    "simulation",
    "mujoco",
    "mjlab",
    "sim-to-real",
    "system-identification",
    "telemetry",
    "mcp"
  ],
  "skills": "./.claude/skills",
  "agents": [
    "./.claude/agents/data-generator.md",
    "./.claude/agents/deploy-engineer.md",
    "./.claude/agents/evaluator.md",
    "./.claude/agents/policy-trainer.md",
    "./.claude/agents/robot-onboarding.md",
    "./.claude/agents/system-identification.md",
    "./.claude/agents/task-designer.md"
  ],
  "mcpServers": {
    "trainnr": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}/trainnr",
        "--extra",
        "sim",
        "--extra",
        "mcp",
        "trainnr",
        "mcp"
      ]
    }
  }
}
