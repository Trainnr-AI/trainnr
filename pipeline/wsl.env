# The WSL box's launch environment for the sim and viewer tools — one file,
# so no tool docstring carries its own copy (they did, in four different
# subsets, until 2026-08-27). Use it as
#     cd pipeline && uv run --env-file wsl.env --extra sim --extra viz python ../tools/<tool>.py
# or, for the train venv,
#     cd pipeline && ../tools/wsl-run.sh .venv-train/bin/python ../tools/<tool>.py
# Harmless on a native Linux box; unnecessary on macOS and Windows.
# Plain KEY=VALUE lines only: two parsers read this file (bash via `set -a`
# in wsl-run.sh, uv's dotenv via --env-file) and they agree on nothing else.
#
# MuJoCo's OpenGL and EGL go to the RTX through Mesa's D3D12 driver; the
# default pick under WSLg is llvmpipe, the software rasterizer — measured
# 2026-08-26: 317 ms per 640x480 frame, fifty threads at 800% CPU, against
# 31 ms on the card.
GALLIUM_DRIVER=d3d12
# Rerun's viewer on the Dozen/D3D12 Vulkan adapter (Mesa 25.0.7 from the
# kisak/turtle PPA; the kisak-mesa PPA's jammy index is empty).
WGPU_BACKEND=vulkan
# Offscreen rendering for the harness, the demo generator and playback.
MUJOCO_GL=egl
# Warp finds the GPU here; without it "CUDA error 100" and a CPU fallback.
LD_LIBRARY_PATH=/usr/lib/wsl/lib
# CPU simulation tools: one BLAS thread. Parallelism here is worlds, not threads.
OMP_NUM_THREADS=1
