#!/usr/bin/env bash
# Fast gates, run on every commit. Anything slower belongs in
# tools/verify.sh, which you run before pushing.
#
# Installed by tools/setup-hooks.sh, which points core.hooksPath here so
# the hooks are versioned like everything else. A hook living only in
# .git/hooks is a hook that exists on one machine.
#
# Bypass with `git commit --no-verify` when you genuinely mean to — for a
# work-in-progress commit on a branch, say. Not for main.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
source "$HOME/.cargo/env" 2>/dev/null || true
# The clippy gate below greps for lines STARTING with "error". CI's
# shakedown proved forced cargo colors defeat that grep (the ANSI prefix
# hides the word) — a build failure then sails through the gate. Same
# guard CI uses, applied here.
export CARGO_TERM_COLOR=never

fail=0
gate() {
  printf "  %-34s" "$1"
  if out=$(eval "$2" 2>&1); then echo "ok"; else echo "FAIL"; echo "$out" | tail -12; fail=1; fi
}

echo "pre-commit:"
# the Studio is the one Rust crate left (the rig's crates and firmware
# moved to a private archive on 2026-10-02). It is its own workspace — own Cargo.lock, the rerun 0.36
# pins — so every cargo gate runs inside it. Before the move it was
# `exclude`d from the root workspace and a review found drift the root's
# "formatting ok" stamps had been vacuously blessing: a workspace needs its
# own gates, or it has none.
gate "formatting (trainnr-studio)" "cd crates/trainnr-studio && cargo fmt --check"
gate "clippy (trainnr-studio)"     "! (cd crates/trainnr-studio && cargo clippy -q --all-targets 2>&1) | grep -qE '^error'"
gate "tests (trainnr-studio)"      "cd crates/trainnr-studio && cargo test -q"
# NOT a grep for `unsafe`. The COMPILER forbids it — `unsafe_code =
# "forbid"` in the manifest — so a grep here would only duplicate that,
# worse. The first version did exactly that, required `unsafe` at the
# start of a line, and cheerfully passed `fn f() { unsafe { } }`. A gate
# that gives false confidence is worse than no gate.
#
# So this checks the GUARD, not the code: that every crate still declares
# the forbid. Deleting a line from a manifest is the only way unsafe gets
# in, and that is the thing to notice.
gate "unsafe still forbidden"    "python3 tools/check-unsafe-gates.py"
gate "docs describe real code" "python3 tools/check-docs.py"
gate "package layers (docs/80)" "python3 tools/check-layers.py"
# Every k/n the README quotes has a finding record behind it — the
# 2026-09-04 audit found five quoted numbers with none.
gate "numbers trace to records"  "python3 tools/check-numbers.py"

# Python gets the same treatment as Rust — ruff is its clippy+rustfmt and
# the unit suite is fast enough to run on every commit. Gated on uv being
# present so a Rust-only contributor is not blocked by tooling they never
# touch; CI must not use that escape hatch. (The directory test read
# `pipeline` from the rename until 2026-10-02 and skipped every Python
# gate without a word.)
if [ -d trainnr ] && command -v uv >/dev/null 2>&1; then
  RUFF="ruff@0.16.10"  # as CI and tools/verify.sh: the ruff-pre-commit rev in .pre-commit-config.yaml
  gate "ruff format (trainnr)"  "cd trainnr && uvx $RUFF format --check ."
  gate "ruff lint (trainnr)"    "cd trainnr && uvx $RUFF check ."
  gate "ruff format (tools)"    "cd trainnr && uvx $RUFF format --check ../tools"
  gate "ruff lint (tools)"      "cd trainnr && uvx $RUFF check ../tools"
  gate "python tests (trainnr)" "cd trainnr && uv run --extra sim --extra mcp --extra deploy --extra viz python -m unittest discover -s tests"
fi

[ "$fail" -eq 0 ] || {
  echo
  echo "Commit blocked. Fix the above, or --no-verify if you mean it."
  exit 1
}
