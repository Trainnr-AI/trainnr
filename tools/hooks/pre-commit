#!/usr/bin/env bash
# Fast gates, run on every commit. Anything slower belongs in
# tools/verify.sh, which you run before pushing.
#
# Installed by tools/setup-hooks.sh, which points core.hooksPath here so
# the hooks are versioned like everything else. A hook living only in
# .git/hooks is a hook that exists on one machine.
#
# Bypass with `git commit --no-verify` when you genuinely mean to — for a
# work-in-progress commit on a branch, say. Not for main.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
source "$HOME/.cargo/env" 2>/dev/null || true
# The clippy gate below greps for lines STARTING with "error". CI's
# shakedown proved forced cargo colors defeat that grep (the ANSI prefix
# hides the word) — a build failure then sails through the gate. Same
# guard CI uses, applied here.
export CARGO_TERM_COLOR=never

fail=0
gate() {
  printf "  %-34s" "$1"
  if out=$(eval "$2" 2>&1); then echo "ok"; else echo "FAIL"; echo "$out" | tail -12; fail=1; fi
}

echo "pre-commit:"
gate "formatting"            "cargo fmt --all --check"
gate "clippy (no errors)"    "! cargo clippy -q --workspace --all-targets 2>&1 | grep -qE '^error'"
# studio-shell is `exclude`d from the root workspace (its re_ui 0.36 pin
# conflicts with the root's rerun 0.35 over exact wasm-bindgen versions),
# so the two gates above never see it — discovered when a review ran fmt
# there by hand and found drift the "formatting ok" stamps had been
# vacuously blessing. An excluded workspace needs its own gates, or it
# has none.
gate "formatting (studio-shell)" "cd crates/studio-shell && cargo fmt --check"
gate "clippy (studio-shell)"     "! (cd crates/studio-shell && cargo clippy -q --all-targets 2>&1) | grep -qE '^error'"
gate "tests (studio-shell)"      "cd crates/studio-shell && cargo test -q"
# NOT a grep for `unsafe`. The COMPILER forbids it — `unsafe_code =
# "forbid"` in every manifest, `#![forbid(unsafe_code)]` in every
# firmware — so a grep here would only duplicate that, worse. The first
# version did exactly that, required `unsafe` at the start of a line, and
# cheerfully passed `fn f() { unsafe { } }`. A gate that gives false
# confidence is worse than no gate.
#
# So this checks the GUARD, not the code: that every crate still declares
# the forbid. Deleting a line from a manifest is the only way unsafe gets
# in, and that is the thing to notice.
gate "unsafe still forbidden everywhere" "python3 tools/check-unsafe-gates.py"
gate "docs describe real code" "python3 tools/check-docs.py"
# Every k/n in the paper drafts and ledgers has a finding record behind
# it — the 2026-09-04 audit found five quoted numbers with none.
gate "numbers trace to records"  "python3 tools/check-numbers.py"
# The assembled manuscript is generated from the section drafts; a
# stale copy is a lie about what the drafts say.
gate "manuscript current"        "python3 tools/paper.py --check"

# Python gets the same treatment as Rust — ruff is its clippy+rustfmt and
# the unit suite is fast enough to run on every commit. Gated on uv being
# present so a Rust-only contributor is not blocked by tooling they never
# touch; CI must not use that escape hatch.
if [ -d pipeline ] && command -v uv >/dev/null 2>&1; then
  gate "ruff format (pipeline)" "cd pipeline && uvx ruff format --check ."
  gate "ruff lint (pipeline)"   "cd pipeline && uvx ruff check ."
  gate "ruff format (tools)"    "cd pipeline && uvx ruff format --check ../tools"
  gate "ruff lint (tools)"      "cd pipeline && uvx ruff check ../tools"
  gate "python tests (pipeline)" "cd pipeline && uv run python -m unittest discover -s tests"
fi

[ "$fail" -eq 0 ] || {
  echo
  echo "Commit blocked. Fix the above, or --no-verify if you mean it."
  exit 1
}
