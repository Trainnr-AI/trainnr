# Bundle identity is a hash of file bytes (trainnr/trainnr/bundles/hashing.py).
# A Windows checkout with autocrlf would change every .xml/.md's bytes and
# every name@hash stamp with them; pin line endings so the stamp is the
# same on every machine.
* text=auto eol=lf
*.png binary
*.jpg binary
*.stl binary
*.obj binary
*.mp4 binary
*.gz binary
*.wire binary
*.npz binary

# Generated files and recorded evidence: kept out of GitHub's language
# statistics and collapsed in pull request diffs.
docs/findings/** linguist-generated=true
docs/artifacts/** linguist-generated=true linguist-detectable=false
docs/68-findings.md linguist-generated=true
docs/paper/paper-1.md linguist-generated=true
*.lock linguist-generated=true
uv.lock linguist-generated=true
