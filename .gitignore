# Rust build output (both the workspace and each standalone firmware crate)
target/
**/target/

# Built firmware images — regenerated by tools/sim-*.sh
*.uf2

# Vendored emulator: upstream MIT code, cloned by tools/setup-emulator.sh.
# Our contributions to it live in tools/harness/ and tools/patches/.
tools/rp2040js/

node_modules/

# macOS
.DS_Store

# uv-managed virtualenvs (trainnr/)
.venv/
.venv-train/
.venv-usd/
# Training runs: checkpoints and logs are artifacts by hash, not source.
trainnr/runs/
__pycache__/
*.egg-info/
# Generated debris: MuJoCo's cwd log, episode/training
# output (artifacts travel by hash, never as source), ruff cache.
MUJOCO_LOG.TXT
runs/
.ruff_cache/

# Local secrets/config: never tracked (a root .env appeared 2026-08-26).
.env
.env.*

# Per-user Claude Code settings (shared settings, if any, live in .claude/settings.json).
.claude/settings.local.json

# coverage databases carry absolute paths; per machine, never tracked
.coverage*
# LaTeX build products of tools/paper-tex.py (main.tex and main.pdf are tracked)
docs/paper/latex/figures/
docs/paper/latex/*.aux
docs/paper/latex/*.log
docs/paper/latex/*.out
docs/paper/latex/*.fls
docs/paper/latex/*.fdb_latexmk
docs/paper/latex/*.toc
docs/paper/latex/*.synctex.gz
.playwright-mcp/
# the forks' worktrees (claude worktree plugin), never part of the tree
.claude/worktrees/

# The Studio log the launch line redirects to when started by hand.
scratchpad/

# The maintainers private session notes: never tracked again (filtered from history at the public export).
claude-sync/

# uv build / setuptools output
trainnr/build/
trainnr/dist/
trainnr-mjlab/build/
trainnr-mjlab/dist/
