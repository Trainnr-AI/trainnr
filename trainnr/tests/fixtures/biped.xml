<mujoco model="biped">
  <compiler angle="radian"/>
  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1"/>
    <body name="torso" pos="0 0 0.3">
      <freejoint name="root"/>
      <geom type="box" size="0.05 0.04 0.03" mass="0.5"/>
      <site name="imu"/>
      <body name="head" pos="0 0 0.05">
        <joint name="neck_yaw" axis="0 0 1" range="-1 1"/>
        <geom type="sphere" size="0.02" mass="0.05"/>
      </body>
      <body name="left_thigh" pos="0 0.03 -0.03">
        <joint name="left_hip" axis="0 1 0" range="-1.5 1.5"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.1" size="0.01" mass="0.05"/>
        <body name="left_shin" pos="0 0 -0.1">
          <joint name="left_knee" axis="0 1 0" range="-2 0"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.1" size="0.01" mass="0.05"/>
          <geom name="left_foot_collision" type="sphere" pos="0 0 -0.1" size="0.015"/>
          <site name="left_foot" pos="0 0 -0.11"/>
        </body>
      </body>
      <body name="right_thigh" pos="0 -0.03 -0.03">
        <joint name="right_hip" axis="0 1 0" range="-1.5 1.5"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.1" size="0.01" mass="0.05"/>
        <body name="right_shin" pos="0 0 -0.1">
          <joint name="right_knee" axis="0 1 0" range="-2 0"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.1" size="0.01" mass="0.05"/>
          <geom name="right_foot_collision" type="sphere" pos="0 0 -0.1" size="0.015"/>
          <site name="right_foot" pos="0 0 -0.11"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator><position joint="neck_yaw" kp="5"/><position joint="left_hip" kp="5"/><position joint="left_knee" kp="5"/><position joint="right_hip" kp="5"/><position joint="right_knee" kp="5"/></actuator>
  <sensor>
    <velocimeter name="imu_lin_vel" site="imu"/>
    <gyro name="imu_ang_vel" site="imu"/>
  </sensor>
  <keyframe>
    <key name="zero" qpos="0 0 0.3 1 0 0 0 0 0 0 0 0"/>
    <key name="stand" qpos="0 0 0.28 1 0 0 0 0 0.2 -0.4 0.2 -0.4"/>
  </keyframe>
</mujoco>
